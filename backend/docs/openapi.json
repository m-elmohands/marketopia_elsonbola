{
  "openapi": "3.0.3",
  "info": {
    "title": "Golden Spike Public Content API",
    "version": "1.0.0",
    "description": "Read-only bilingual product showcase. Body and description fields contain plain text, not HTML. Drafts and deleted content are excluded. Limit: 120 requests per minute per IP."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Requested content language. No mixed-language fallback.",
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "default": "ar"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 12
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "featured",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "sort_order",
                "name",
                "-name",
                "newest"
              ],
              "default": "sort_order"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "404": {
            "description": "Content not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Operational failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products/{slug}": {
      "get": {
        "operationId": "getProduct",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Requested content language. No mixed-language fallback.",
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "default": "ar"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "404": {
            "description": "Content not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Operational failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/pages/{key}": {
      "get": {
        "operationId": "getPage",
        "tags": [
          "Content"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Requested content language. No mixed-language fallback.",
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "default": "ar"
            }
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "about",
                "contact"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Content not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Operational failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "operationId": "getBusinessSettings",
        "tags": [
          "Settings"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Requested content language. No mixed-language fallback.",
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "default": "ar"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Content not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Operational failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products/details": {
      "get": {
        "operationId": "getProductById",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Requested content language. No mixed-language fallback.",
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "default": "ar"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Positive product ID; decimal integers only, without leading zeros.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "404": {
            "description": "Content not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Operational failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Get a published product by its numeric ID"
      }
    }
  },
  "components": {
    "schemas": {
      "Media": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "collection": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "web_url": {
            "type": "string",
            "format": "uri"
          },
          "thumbnail_url": {
            "type": "string",
            "format": "uri"
          },
          "alt": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "nullable": true
          }
        }
      },
      "ProductVariant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "weight_kg": {
            "type": "string",
            "example": "5.000"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "short_description": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "meta_title": {
            "type": "string",
            "nullable": true
          },
          "meta_description": {
            "type": "string",
            "nullable": true
          },
          "is_featured": {
            "type": "boolean"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVariant"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "home",
              "about",
              "contact"
            ]
          },
          "title": {
            "type": "string"
          },
          "intro": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string",
            "nullable": true
          },
          "meta_title": {
            "type": "string",
            "nullable": true
          },
          "meta_description": {
            "type": "string",
            "nullable": true
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          }
        }
      },
      "BusinessSettings": {
        "type": "object",
        "properties": {
          "brand_name": {
            "type": "string"
          },
          "tagline": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "opening_hours": {
            "type": "string",
            "nullable": true
          },
          "quality_highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "facebook_url": {
            "type": "string",
            "nullable": true
          },
          "whatsapp_number": {
            "type": "string",
            "nullable": true
          },
          "map_url": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "string",
            "nullable": true
          },
          "longitude": {
            "type": "string",
            "nullable": true
          },
          "contact_numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phone": {
                  "type": "string"
                },
                "is_primary": {
                  "type": "boolean"
                }
              }
            }
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "data": {
            "nullable": true
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {}
          }
        },
        "required": [
          "data",
          "message",
          "errors",
          "meta"
        ]
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "nullable": true
          },
          "meta": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "required": [
          "data",
          "message",
          "errors",
          "meta"
        ]
      },
      "ProductResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Product"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "nullable": true
          },
          "meta": {
            "type": "object",
            "properties": {}
          }
        },
        "required": [
          "data",
          "message",
          "errors",
          "meta"
        ]
      },
      "PageResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Page"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "nullable": true
          },
          "meta": {
            "type": "object",
            "properties": {}
          }
        },
        "required": [
          "data",
          "message",
          "errors",
          "meta"
        ]
      },
      "SettingsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/BusinessSettings"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "nullable": true
          },
          "meta": {
            "type": "object",
            "properties": {}
          }
        },
        "required": [
          "data",
          "message",
          "errors",
          "meta"
        ]
      }
    }
  }
}
